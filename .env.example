# Data-plane configuration. Copy to .env and fill in locally; never commit real values.

# Postgres connection string for durable snapshot/job-health storage.
# When unset, the service falls back to an in-memory store (dev/tests only).
# DATABASE_URL=postgres://user:password@host:5432/dbname

# HTTP port for the health/status API. Defaults to 8080.
# PORT=8080

# --- Market data providers (server-only, never NEXT_PUBLIC_*) ---

# OnchainOS / OKX Web3 DEX. Preferred kline and price source. All four are read
# together: without API key, secret and passphrase the adapter reports itself as
# unavailable and the kline chain falls through to the next source.
# OKX_API_KEY=
# OKX_SECRET_KEY=
# OKX_PASSPHRASE=
# OKX_PROJECT_ID=

# Birdeye. OHLCV-only fallback, used when OnchainOS and Sintral both fail.
# BIRDEYE_API_KEY=

# GMGN. Secondary security and holder enrichment behind /security. Slow (~400ms)
# and aggressively rate limited — repeated violations earn a temporary IP ban —
# so it is only ever called on demand and is cached hard. Without the key the
# security tier simply runs on OnchainOS alone.
# GMGN_API_KEY=

# --- BSC JSON-RPC (PancakeSwap pool reads and Venus health factors) ---

# Tried in this order, then a set of keyless public endpoints as a last resort,
# rotating past any that fail. A URL may embed a provider key, so it is never
# logged. Public endpoints rate-limit and cap eth_getLogs; configure at least one
# real endpoint for production.
# BSC_RPC_URL=
# BSC_RPC_URL1=
# BSC_RPC_URL2=
# BSC_RPC_URL3=

# Four.Meme, the Binance Web3 / Sintral endpoints and PancakeSwap's cached
# explorer API all need no credentials.
