{
  "name": "4lpha-data-plane",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone data-plane service: snapshot store, job scheduler, health HTTP API.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "smoke": "node --import tsx scripts/smoke.ts",
    "loadtest": "tsx scripts/dp-load-test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "hono": "^4.7.0",
    "pg": "^8.13.0",
    "viem": "^2.55.11"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
